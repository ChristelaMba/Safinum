# Copier ce fichier en .env puis remplir. Ne jamais mettre une cle dans le depot.

# --- Moteur de langage : anthropic (defaut), openai (tout fournisseur compatible OpenAI), ollama (local), test
SAFINUM_MOTEUR=anthropic

# Fournisseur Anthropic
ANTHROPIC_API_KEY=
SAFINUM_MODEL=claude-sonnet-5-5
# Modele rapide pour les libelles courts (laisser vide = meme modele)
SAFINUM_MODEL_RAPIDE=

# Fournisseur compatible OpenAI (Groq, Gemini en mode OpenAI, OpenRouter...) ou Ollama
# Exemple : SAFINUM_MOTEUR=openai, SAFINUM_LLM_URL=https://adresse/v1, SAFINUM_LLM_KEY=..., SAFINUM_MODEL=nom-du-modele
SAFINUM_LLM_URL=
SAFINUM_LLM_KEY=

# --- Debit (a regler selon les limites du fournisseur gratuit)
SAFINUM_LOT=25
SAFINUM_CONCURRENCE=4
SAFINUM_DELAI=25
# Requetes par minute et par client
SAFINUM_DEBIT=120

# --- Securite
# Origines autorisees en plus de l'extension (separees par des virgules), par exemple le site du jury pour le script autonome
SAFINUM_CORS=http://localhost:8000,http://127.0.0.1:8000
# 1 = autorise toutes les origines (developpement seulement)
SAFINUM_DEV_CORS=0

# --- Langues
# 1 = seules les entrees de glossaire validees par un locuteur comptent comme confiance elevee
SAFINUM_STRICT=0
# 1 = active /v1/tts (voix MMS, il faut transformers, torch, scipy)
SAFINUM_TTS=0
